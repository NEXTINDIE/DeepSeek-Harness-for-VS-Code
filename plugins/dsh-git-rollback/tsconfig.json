{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["../../node_modules/@deepseek-ai/dsh-session/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-commands": ["../../node_modules/@deepseek-ai/dsh-commands/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent": ["../../node_modules/@deepseek-ai/dsh-agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../../node_modules/@deepseek-ai/dsh-host-webserver/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client"]
}
